                    missing_cols = missing_info[missing_info > 0]
                    
                    col1, col2 = st.columns(2)
                    with col1:
                        st.subheader("📊 Data Sebelum")
                        st.write("**Missing values per kolom:**")
                        if len(missing_cols) > 0:
                            st.dataframe(missing_cols, use_container_width=True)
                        else:
                            st.info("✓ Tidak ada missing values dalam dataset")
                        st.dataframe(df_clean.head(), use_container_width=True)
                    
                    # Buat salinan data
                    df_imputed = df_clean.copy()
                    
                    # Pisahkan target jika ada
                    if target_col in df_imputed.columns:
                        y_raw = df_imputed[target_col].copy()
                        X = df_imputed.drop(columns=[target_col])
                    else:
                        X = df_imputed.copy()
                        y_raw = None
                    
                    # Lakukan imputasi dan tracking perubahan
                    impute_stats = {}
                    for c in X.select_dtypes(include="number").columns:
                        if X[c].isnull().sum() > 0:
                            # Catat statistik sebelum imputasi
                            impute_stats[c] = {
                                "tipe": "numerik",
                                "jumlah_na": X[c].isnull().sum(),
                                "nilai_isian": X[c].median()
                            }
                            # Lakukan imputasi
                            X[c] = X[c].fillna(X[c].median())
                    
                    for c in X.select_dtypes(exclude="number").columns:
                        if X[c].isnull().sum() > 0:
                            mode_val = X[c].mode()
                            fill_val = mode_val[0] if len(mode_val) > 0 else ""
                            # Catat statistik
                            impute_stats[c] = {
                                "tipe": "kategorikal",
                                "jumlah_na": X[c].isnull().sum(),
                                "nilai_isian": fill_val
                            }
                            # Lakukan imputasi
                            X[c] = X[c].fillna(fill_val)
                    
                    # Gabungkan kembali dengan target jika ada
                    if y_raw is not None:
                        df_imputed = pd.concat([X, y_raw], axis=1)
                    else:
                        df_imputed = X
                    
                    results["step2"] = df_imputed
                    
                    with col2:
                        st.subheader("📊 Data Sesudah")
                        if impute_stats:
                            st.write("**Detail imputasi yang dilakukan:**")
                            for col, stats in impute_stats.items():
                                st.write(f"- {col} ({stats['tipe']}): {stats['jumlah_na']} nilai diisi dengan {stats['nilai_isian']}")
                        else:
                            st.info("✓ Tidak ada nilai yang perlu diisi (tidak ada missing values)")
                        st.dataframe(df_imputed.head(), use_container_width=True)
                    
                    if impute_stats:
