                        y_raw = None
                    
                    # Identifikasi kolom yang akan di-encode manual
                    manual_cols = [c for c in X.columns if c in MANUAL_MAP and not pd.api.types.is_numeric_dtype(X[c])]
                    
                    col1, col2 = st.columns(2)
                    with col1:
                        st.subheader("📊 Data Sebelum")
                        if manual_cols:
                            st.write(f"**Kolom yang akan di-encode manual ({len(manual_cols)}):**")
                            for col in manual_cols:
                                unique_vals = X[col].dropna().unique()[:5]  # Show first 5 unique values
                                st.write(f"- {col}: {list(unique_vals)}{'...' if len(X[col].unique()) > 5 else ''}")
                        else:
                            st.info("Tidak ada kolom yang perlu di-encode manual")
                        
                        st.dataframe(X[manual_cols].head() if manual_cols else X.head(), use_container_width=True)
                    
                    # Lakukan encoding manual
                    encoding_results = {}
                    for col_readable, mapper in MANUAL_MAP.items():
                        if col_readable in X.columns and not pd.api.types.is_numeric_dtype(X[col_readable]):
                            col = col_readable
                            raw_norm = X[col].astype(str).map(_norm)
                            mapped = raw_norm.map(mapper)
                            
                            # Tracking unmapped values
                            unmapped = sorted(set(raw_norm[pd.isna(mapped)]))
                            
                            # Isi unmapped values dengan fallback
                            if len(unmapped) > 0:
                                mode_val = X[col].mode()[0] if len(X[col].mode()) > 0 else X[col].iloc[0]
                                fallback = mapper.get(_norm(mode_val), 0.0)
                                mapped = mapped.fillna(fallback)
                                
                                encoding_results[col] = {
                                    "status": "partial",
                                    "unmapped": unmapped,
                                    "fallback": fallback,
                                    "before_unique": X[col].nunique(),
                                    "after_unique": mapped.nunique()
                                }
                            else:
                                encoding_results[col] = {
                                    "status": "success",
                                    "before_unique": X[col].nunique(),
                                    "after_unique": mapped.nunique()
                                }
                            
                            # Update kolom dengan nilai hasil encoding
                            X[col] = mapped.astype(float)
                    
                    # Gabungkan kembali dengan target jika ada
                    if y_raw is not None:
                        df_encoded = pd.concat([X, y_raw], axis=1)
                    else:
                        df_encoded = X
                    
