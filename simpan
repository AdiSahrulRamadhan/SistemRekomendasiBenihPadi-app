                    st.pyplot(fig2)
            else:
                st.info("Naive Bayes sedang diproses...")
        
        # Tab SVM - Kustomisasi dan Training Terpisah
        with model_tabs[2]:
            st.subheader("🔧 Support Vector Machine")
            
            # Kustomisasi parameter SVM
            st.subheader("⚙️ Kustomisasi Parameter SVM")
            
            col1, col2 = st.columns(2)
            with col1:
                kernel_type = st.selectbox(
                    "Kernel SVM",
                    options=["rbf", "linear", "poly", "sigmoid"],
                    index=0  # Default: rbf
                )
                
                gamma_option = st.selectbox(
                    "Gamma",
                    options=["scale", "auto", "custom"],
                    index=0  # Default: scale
                )
                
                if gamma_option == "custom":
                    gamma_value = st.number_input("Nilai Gamma", 
                                                min_value=0.0001, 
                                                max_value=100.0, 
                                                value=0.1, 
                                                format="%.4f",
                                                step=0.01)
                else:
                    gamma_value = gamma_option
            
            with col2:
                C_value = st.slider("Parameter Regularisasi (C)", 
                                   min_value=0.1, 
                                   max_value=10.0, 
                                   value=1.0,  # Default: 1.0 
                                   step=0.1)
                
                if kernel_type == "poly":
                    poly_degree = st.slider("Derajat Polinomial", 
                                           min_value=2, 
                                           max_value=10, 
                                           value=3)
                else:
                    poly_degree = 3
            
            # Buat nama SVM berdasarkan kernel yang dipilih    
            svm_name = f"SVM ({kernel_type.upper()})"
            
            # Cek apakah model SVM dengan kernel ini sudah ada
            svm_exists = False
            for name in st.session_state.pipelines.keys():
                if name.startswith("SVM") and kernel_type.upper() in name:
                    svm_exists = True
                    svm_name = name
                    break
            
            # Tombol untuk melatih SVM dengan parameter yang dipilih
            if not svm_exists:
                if st.button("🚀 Latih Model SVM", use_container_width=True):
                    with st.spinner(f"Melatih model {svm_name}..."):
                        # Buat SVM dengan parameter yang dikustomisasi
                        if kernel_type == "poly":
                            model_svm = SVC(
                                kernel=kernel_type, 
                                C=C_value, 
                                gamma=gamma_value, 
                                degree=poly_degree,
                                probability=True, 
                                random_state=42
                            )
                        else:
                            model_svm = SVC(
                                kernel=kernel_type, 
                                C=C_value, 
                                gamma=gamma_value, 
                                probability=True, 
                                random_state=42
                            )
                        
                        # Evaluasi dengan cross-validation
                        cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
                        svm_preds = cross_val_predict(model_svm, X, y, cv=cv, method="predict")
                        
                        # Simpan metrik evaluasi
                        st.session_state.metrics[svm_name] = {
                            "accuracy": accuracy_score(y, svm_preds),
                            "f1_macro": f1_score(y, svm_preds, average="macro", zero_division=0),
                            "report": classification_report(y, svm_preds, zero_division=0, output_dict=True),
                            "cm": confusion_matrix(y, svm_preds),
                            "cm_norm": confusion_matrix(y, svm_preds, normalize="true"),
                            "params": {
                                "kernel": kernel_type,
                                "C": C_value,
                                "gamma": gamma_value,
                                "degree": poly_degree if kernel_type == "poly" else None
                            }
                        }
                        
                        # Latih model final
                        model_svm.fit(X, y)
                        st.session_state.pipelines[svm_name] = model_svm
                        
                        st.success(f"✅ Model {svm_name} berhasil dilatih!")
                        st.experimental_rerun()  # Reload untuk menampilkan hasil
            
            # Cari nama SVM model yang sudah dilatih
            svm_models = [name for name in st.session_state.metrics.keys() if "SVM" in name]
            
            if svm_models:
                # Pilih model SVM yang akan ditampilkan (jika lebih dari 1)
                if len(svm_models) > 1:
                    selected_svm = st.selectbox("Pilih model SVM:", svm_models, index=0)
                else:
                    selected_svm = svm_models[0]
                
                metrics = st.session_state.metrics[selected_svm]
                
                # Tampilkan parameter SVM yang digunakan
                st.subheader(f"Parameter {selected_svm}")
                if "params" in metrics:
                    params = metrics["params"]
                    st.write(f"- Kernel: {params['kernel']}")
                    st.write(f"- C: {params['C']}")
                    st.write(f"- Gamma: {params['gamma']}")
                    if params['degree'] is not None:
                        st.write(f"- Degree: {params['degree']}")
                elif "(" in selected_svm:
                    kernel_used = selected_svm.split("(")[1].split(")")[0].lower()
                    st.write(f"- Kernel: {kernel_used}")
                
                # Tampilkan metrik
                st.markdown(f"### {selected_svm} — Akurasi: **{metrics['accuracy']*100:.2f}%** | F1-macro: **{metrics['f1_macro']:.3f}**")
                
                # Classification report
                st.subheader("Laporan Klasifikasi")
                report_df = pd.DataFrame(metrics["report"]).transpose()
                st.dataframe(report_df.style.highlight_max(axis=0, subset=["precision", "recall", "f1-score"]))
                
                # Tampilkan confusion matrix
                col1, col2 = st.columns(2)
                with col1:
                    st.write("**Confusion Matrix (Raw)**")
                    fig1, ax1 = plt.subplots(figsize=(8, 6))
                    target_classes = list(st.session_state.label_y.classes_)
                    ConfusionMatrixDisplay(metrics["cm"], display_labels=target_classes).plot(ax=ax1, cmap="Blues", values_format='d')
                    ax1.set_title(f"Confusion Matrix (Raw) — {selected_svm}")
                    st.pyplot(fig1)
                
                with col2:
                    st.write("**Confusion Matrix (Normalized)**")
                    fig2, ax2 = plt.subplots(figsize=(8, 6))
                    ConfusionMatrixDisplay(metrics["cm_norm"], display_labels=target_classes).plot(ax=ax2, cmap="Blues")
                    ax2.set_title(f"Confusion Matrix (Normalized) — {selected_svm}")
                    st.pyplot(fig2)
                
                # Jika ada model SVM lainnya, tambahkan tombol untuk melatih model SVM baru
                if not svm_exists:
                    st.info(f"Anda dapat melatih model SVM baru dengan parameter berbeda menggunakan tombol di atas.")
                else:
                    if st.button("🔄 Latih Model SVM Baru dengan Parameter di Atas", use_container_width=True):
                        # Hapus model SVM yang sudah ada dengan kernel yang sama
                        if svm_name in st.session_state.pipelines:
                            del st.session_state.pipelines[svm_name]
                        if svm_name in st.session_state.metrics:
                            del st.session_state.metrics[svm_name]
                        st.experimental_rerun()  # Reload untuk menampilkan form latih model baru
            else:
                st.info("Belum ada model SVM yang dilatih. Gunakan panel kustomisasi di atas dan klik 'Latih Model SVM'.")

# ==================
# 5) TESTING / PREDIKSI
# ==================
elif step.startswith("5"):
    st.title("5) Testing / Prediksi")

    if not st.session_state.trained:
        st.warning("Latih model dulu di tahap 4.")
    else:
        TARGET_COL = st.session_state.TARGET_COL
        X_columns = st.session_state.X_columns
        scaler = st.session_state.scaler
        label_y = st.session_state.label_y
        models = st.session_state.pipelines

        st.subheader("Masukkan indikator (1 sampel)")

        # Build form inputs sesuai fitur
        with st.form("input_form"):
            inputs = {}
            cols = st.columns(2)
            for i, col in enumerate(X_columns):
                with cols[i % 2]:
                    if col in MANUAL_MAP:  # kategorikal yang dimapping
                        # tampilkan pilihan human-friendly (keys asli sebelum _norm)
                        # kita tampilkan opsi 'label' yang umum dipakai
                        reverse_show = {
                            "Kerebahan": ["Tahan", "Sedang", "Tidak Tahan"],
                            "TeksturNasi": ["Pulen", "Agak Pulen", "Agak Pera", "Pera"],
                            "KetahananTerhadapHama": ["Tahan", "Agak Tahan", "Sedang", "Agak Rentan", "Rentan", "Tidak Tahan"],
                            "Kerontokan": ["Tahan", "Toleran", "Kuat", "Sedang", "Agak Tahan", "Mudah", "Rentan"],
                            "WarnaGabah": ["Kuning Bersih", "Kuning Jerami", "Kuning"],
                        }
                        pilihan = reverse_show.get(col, list(MANUAL_MAP[col].keys()))
                        inputs[col] = st.selectbox(col, options=pilihan)
                    else:
                        # numerik
                        default_val = 0.0
                        if col.lower() in ["phtanah"]: default_val = 5.5
                        if col.lower() in ["umurtanaman"]: default_val = 115
                        if col.lower() in ["potensihasil"]: default_val = 5.0
                        inputs[col] = st.number_input(col, value=float(default_val))

            model_name = st.selectbox("Pilih model", list(models.keys()))
            show_topk = st.checkbox("Tampilkan Top-3 probabilitas (jika tersedia)", value=True)
            submitted = st.form_submit_button("🔮 Prediksi")

        def preprocess_input_for_inference(raw_dict, X_columns, scaler):
            # terapkan mapping manual utk kolom kategori (sama seperti training)
            row = {}
            for col in X_columns:
                if col in MANUAL_MAP:
                    v = raw_dict.get(col, None)
                    mapped = MANUAL_MAP[col].get(_norm(v), None)
                    if mapped is None:
                        mapped = 0.0
                    row[col] = float(mapped)
                else:
                    val = raw_dict.get(col, 0.0)
                    if isinstance(val, str):
                        val = val.replace(",", ".")
                    try:
                        row[col] = float(val)
                    except:
                        row[col] = 0.0
            X_one = pd.DataFrame([[row.get(c, 0.0) for c in X_columns]], columns=X_columns)
            # scale dengan scaler training
            X_scaled = pd.DataFrame(scaler.transform(X_one), columns=X_columns)
            return X_scaled

        if submitted:
            try:
                X_one = preprocess_input_for_inference(inputs, X_columns, scaler)
                clf = models[model_name]
                y_pred = clf.predict(X_one)
                varietas = label_y.inverse_transform(y_pred)[0]
                st.success(f"🌾 **Rekomendasi varietas** ({model_name}): **{varietas}**")

                if show_topk and hasattr(clf, "predict_proba"):
                    proba = clf.predict_proba(X_one)[0]
                    idx = np.argsort(proba)[::-1][:3]
                    st.write("Top-3 keyakinan model:")
                    for i in idx:
                        st.write(f"- {label_y.inverse_transform([i])[0]} — {proba[i]*100:.2f}%")

                st.subheader("Preview input (setelah preprocessing & scaling)")
                st.dataframe(X_one, use_container_width=True)

            except Exception as e:
                st.error(f"Gagal prediksi: {e}")
