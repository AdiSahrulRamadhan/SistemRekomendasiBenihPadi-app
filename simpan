                        else:
                            st.info("✓ Semua kolom sudah numerik")
                        
                        st.dataframe(X[non_num_cols].head() if non_num_cols else X.head(), use_container_width=True)
                    
                    # Lakukan encoding untuk kolom non-numerik yang tersisa
                    encoding_results = {}
                    non_num = X.select_dtypes(exclude="number").columns.tolist()
                    
                    for col in non_num:
